{
  "name": "class-meal-ordering",
  "version": "3.5.3",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "check": "npm run db:verify && npm run check:consistency",
    "check:consistency": "node scripts/check-consistency.mjs",
    "db:list": "node scripts/migrations.mjs list",
    "db:bundle": "node scripts/migrations.mjs bundle",
    "db:verify": "node scripts/migrations.mjs verify --bundle",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "generate:vapid": "node scripts/generate-vapid.js",
    "backup": "node scripts/backup.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "vite": "^7.1.7"
  }
}
