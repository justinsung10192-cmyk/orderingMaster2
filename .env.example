# ===== Supabase（雲端資料庫）=====
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ===== 網站正式網址（重設信連結、推播開啟用）=====
APP_URL=https://class-lunch.vercel.app

# ===== 郵件：Gmail SMTP（免費、免網域）=====
# 1) Gmail 帳戶安全性 → 開啟「兩步驟驗證」
# 2) 搜尋「應用程式密碼」→ 新增（選郵件）→ 得到16碼
# 3) 填入下面（SMTP_PASS = 16碼，不含空格）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=你的gmail@gmail.com
SMTP_PASS=16碼應用程式密碼
EMAIL_FROM=訂餐通 <你的gmail@gmail.com>

# ===== 推播通知（Web Push）=====
# 本機執行 npm run generate:vapid 產生
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ===== 排程保護（api/cron）=====
CRON_SECRET=自訂隨機字元

# ===== 開發者登入通知（開發者登入時寄送，信中可一鍵禁止登入）=====
ADMIN_ALERT_EMAIL=justinsung1019.2@gmail.com

# ===== 開發者金鑰（開發者註冊用）=====
DEVELOPER_MASTER_KEY=自訂另一串隨機字元
