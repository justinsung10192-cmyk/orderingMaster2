# ===== Supabase（雲端資料庫）=====
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ===== 網站正式網址（推播開啟用，不加斜線）=====
APP_URL=https://your-app.vercel.app

# ===== 推播通知（Web Push / VAPID）=====
# 本機執行「npm run generate:vapid」產生
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ===== 排程保護（api/cron）=====
CRON_SECRET=自訂隨機字元

# ===== AI 智慧菜單辨識（二選一即可，Gemini 優先）=====
# Google AI Studio：https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 選用：指定 Gemini 模型（預設 gemini-3.7-flash）
GEMINI_MODEL=
# OpenAI：https://platform.openai.com/api-keys
OPENAI_API_KEY=
